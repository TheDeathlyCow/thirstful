{
	"schemaVersion": 1,
	"id": "thirstful",
	"version": "${version}",
	"name": "Thirstful",
	"description": "A new approach to thirst and food contamination",
	"authors": [
		"TheDeathlyCow"
	],
	"contact": {
		"homepage": "https://www.thedeathlycow.com/thirstful",
		"sources": "${sourceCodeLink}",
		"issues": "https://github.com/TheDeathlyCow/thirstful/issues"
	},
	"license": [
		"AGPL-3.0",
		"CC-BY-SA-4.0 (assets only)"
	],
	"icon": "assets/thirstful/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.thedeathlycow.thirstful.Thirstful"
		],
		"client": [
			"com.thedeathlycow.thirstful.ThirstfulClient"
		],
		"cardinal-components-entity": [
			"com.thedeathlycow.thirstful.registry.TCardinalComponents"
		]
	},
	"mixins": [
		"thirstful.mixins.json",
		"thirstful.mixins.compat.json",
		{
			"config": "thirstful.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "1.21.1",
		"java": ">=21",
		"fabric-api": ">=0.116.7",
		"thermoo": ">=4.5.3",
		"fzzy_config": ">=0.6.8",
		"cardinal-components-base": ">=6.1.2",
		"cardinal-components-entity": ">=6.1.2"
	},
	"suggests": {
		"frostiful": "*",
		"thermoo-patches": "*",
		"scorchful": ">=0.14"
	},
	"breaks": {
		"dehydration": "*"
	},
	"accessWidener": "thirstful.accesswidener",
	"custom": {
		"cardinal-components": [
			"thirstful:player_thirst"
		],
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.thedeathlycow.com",
				"modmenu.kofi": "https://ko-fi.com/thedeathlycow",
				"modmenu.modrinth": "https://modrinth.com/mod/thirstful"
			}
		}
	}
}